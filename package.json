{
  "name": "codex-session-transfer",
  "version": "0.1.3",
  "description": "A private, portable desktop utility for exporting and importing Codex task history.",
  "author": "myyimu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "tauri build",
    "build:mac": "bash scripts/package-mac.sh",
    "build:win": "tauri build --bundles nsis && node scripts/package-windows.mjs",
    "preview": "vite preview",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run test && npm run build:web"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.5"
  }
}
