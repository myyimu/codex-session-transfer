{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex 会话迁移",
  "version": "0.1.7",
  "identifier": "com.yimu.codexsessiontransfer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:web -- --host 127.0.0.1 --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [{
      "title": "Codex 会话迁移",
      "width": 1120,
      "height": 760,
      "minWidth": 900,
      "minHeight": 620,
      "visible": false,
      "titleBarStyle": "Overlay"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "本地迁移 Codex 任务会话",
    "longDescription": "Local-first desktop utility for exporting and importing selected Codex task sessions across computers.",
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "nsis": { "displayLanguageSelector": false } }
  }
}
